# Copy to .env on production server (https://gpsbillx.com)
# NEVER commit .env with real secrets.

APP_NAME="BillX GPS"
APP_BRAND_NAME="BillX GPS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gpsbillx.com
PUBLIC_URL=https://gpsbillx.com
APP_TIMEZONE=Asia/Riyadh

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gps_tracking
DB_USERNAME=
DB_PASSWORD=

TRACCAR_ENABLED=true
TRACCAR_MODE=full
TRACCAR_UNIFIED_IDS=true
TRACCAR_ALLOW_INACTIVE_INGEST=true
TRACKING_INGEST_AUTO_CREATE_DEVICES=false

# Realtime map: Traccar POST → /api/traccar/forward → Reverb
TRACCAR_BROADCAST_POSITIONS=true
TRACCAR_BROADCAST_MODE=forward
TRACCAR_FORWARD_SECRET=
TRACCAR_FORWARD_PROCESS_EVENTS=true
TRACCAR_FORWARD_EVENTS_DEBOUNCE_SECONDS=30
TRACCAR_FORWARD_BROADCAST_MIN_INTERVAL_SECONDS=2
TRACCAR_SCHEDULE_POSITION_EVENTS=true
TRACCAR_POSITION_EVENTS_INTERVAL_MINUTES=5

TRACKING_LIVE_POLL_INTERVAL_MS=10000
TRACKING_LIVE_POLL_INTERVAL_CONNECTED_MS=30000
TRACKING_LIVE_JSON_CACHE_SECONDS=8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=reverb
REVERB_CLIENT_ENABLED=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@gpsbillx.com"
MAIL_FROM_NAME="${APP_NAME}"

NOCAPTCHA_ENABLED=true
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# Laravel Reverb — clients connect via WSS on 443 (Nginx proxy → :8080)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=gpsbillx.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_CREDENTIALS=storage/app/firebase/your-project-firebase-adminsdk.json
FIREBASE_PROJECT_ID=
PUSH_EVENT_NOTIFICATIONS_ENABLED=true
PUSH_GEOFENCE_NOTIFICATIONS_ENABLED=true

SANCTUM_STATEFUL_DOMAINS=gpsbillx.com,www.gpsbillx.com

ASSET_PROTECTION=false
CLIENT_HARDENING=false
BLOCK_SCRAPERS=true
