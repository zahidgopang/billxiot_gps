# Copy to .env on your production server and fill in real values.
# NEVER commit .env with secrets.

APP_NAME="BillX GPS"
APP_BRAND_NAME="BillX GPS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://billxiotgps.com
APP_TIMEZONE=Asia/Karachi

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gps_tracking_billxiot
DB_USERNAME=
DB_PASSWORD=

TRACCAR_ENABLED=true
TRACCAR_MODE=full
TRACCAR_ALLOW_INACTIVE_INGEST=true
TRACKING_INGEST_AUTO_CREATE_DEVICES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=pusher
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

GOOGLE_MAPS_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@billxiotgps.com"
MAIL_FROM_NAME="${APP_NAME}"

NOCAPTCHA_ENABLED=true
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
PUSHER_PORT=443
PUSHER_USETLS=true

PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_CREDENTIALS=storage/app/firebase/your-project-firebase-adminsdk.json
FIREBASE_PROJECT_ID=
PUSH_EVENT_NOTIFICATIONS_ENABLED=true
PUSH_GEOFENCE_NOTIFICATIONS_ENABLED=true

SANCTUM_STATEFUL_DOMAINS=billxiotgps.com,www.billxiotgps.com

ASSET_PROTECTION=false
CLIENT_HARDENING=false
BLOCK_SCRAPERS=true
