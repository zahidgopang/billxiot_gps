APP_NAME="BillX GPS"
APP_BRAND_NAME="BillX GPS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh

# SEO — set APP_URL to your live domain (e.g. https://billxiotgps.com) in production.
# Verification codes from Google Search Console / Bing Webmaster Tools:
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# META_PIXEL_ID=
# SEO_TWITTER_HANDLE=@BillXGPS
# SEO_OG_IMAGE=branding/web/logo_en.png

# Obfuscate JS for production (npm run build:protect). Uses readable public/js when false.
ASSET_PROTECTION=false
# Block right-click / F12 / Ctrl+U on user & admin pages (bypassable deterrent only).
CLIENT_HARDENING=false
# Reject common crawler/download tool user-agents on /user and /admin routes.
BLOCK_SCRAPERS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Traccar shared-database migration (start Traccar once to create tc_* tables)
# TRACCAR_ENABLED=true
# TRACCAR_MODE=full
# off | dual_write (deprecated) | read_traccar | full (recommended)
# TRACCAR_SYNC_ON_CHANGE=false
# TRACCAR_WRITE_LEGACY_TABLES=false
# TRACCAR_SYNC_DEVICES_ON_CHANGE=true
# TRACCAR_SYNC_USERS_ON_CHANGE=true
# TRACCAR_PROTOCOL=laravel
# TRACCAR_SYNC_USERS=true
# TRACCAR_SYNC_USER_PASSWORD=true
# TRACCAR_DEFAULT_USER_PASSWORD=12345678
# TRACCAR_RESET_USER_PASSWORD_ON_SYNC=false
# TRACCAR_SYNC_GEOFENCES=true
# TRACCAR_SYNC_EVENTS=true
# TRACCAR_SYNC_LOG=false
# TRACCAR_DEVICE_DISABLE_WHEN=blocked
# TRACCAR_ALLOW_INACTIVE_INGEST=true
# Auto-create devices on unknown IMEI ingest (off by default in production)
# TRACKING_INGEST_AUTO_CREATE_DEVICES=false

# Default admin seeded into tc_users on php artisan migrate
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=12345678
# ADMIN_NAME=Admin

SESSION_DRIVER=database
# Production: use database or file — NOT "cache" (optimize:clear runs cache:clear and logs everyone out).
# If using Redis sessions, use a different REDIS DB index than CACHE (see REDIS_DB / REDIS_CACHE_DB below).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_DRIVER=reverb
FILESYSTEM_DISK=local

# Laravel Reverb (self-hosted WebSocket). Run `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Hostname only (no scheme). Local: localhost or your Laragon vhost name.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Local HTTPS (Laragon): set REVERB_SCHEME=https, REVERB_TLS=true, and cert paths below.
# REVERB_TLS=true
# REVERB_TLS_CERT=D:/laragon/etc/ssl/laragon.crt
# REVERB_TLS_KEY=D:/laragon/etc/ssl/laragon.key
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Browser/mobile WebSocket client. Set false to skip Echo when Reverb is not running (polling only).
REVERB_CLIENT_ENABLED=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# Google Maps JavaScript API (web panel only) — enable "Maps JavaScript API" in Google Cloud Console.
# Use ONE line only; duplicate GOOGLE_MAPS_API_KEY entries cause the last value to win.
# Under API key → Application restrictions → HTTP referrers, add each host you use, e.g.:
#   https://billxiotgps.com/*
#   https://gps-traccar.devhost/*
#   http://localhost/*
#   https://localhost/*
GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers (Google Cloud Console → Map Management → JavaScript)
GOOGLE_MAPS_MAP_ID=d4cc58ad40625049a573fd2e


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin — create v3 keys)
# Add your domain (and localhost for local testing) under allowed domains.
NOCAPTCHA_ENABLED=true
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=
NOCAPTCHA_SCORE_THRESHOLD=0.5
NOCAPTCHA_ACTION=register

# Bot protection (contact + register forms)
BOT_MIN_FORM_SECONDS=3
BOT_MAX_FORM_SECONDS=7200
BOT_CONTACT_IP_MAX=3
BOT_CONTACT_IP_DECAY=3600
BOT_CONTACT_EMAIL_MAX=2
BOT_REGISTER_IP_MAX=5
BOT_REGISTER_IP_DECAY=3600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Firebase Cloud Messaging (FCM HTTP v1 — service account JSON, never commit the file)
PUSH_NOTIFICATIONS_ENABLED=false
# Path relative to project root, or absolute path
FIREBASE_CREDENTIALS=storage/app/firebase/your-project-firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set true only after push:test succeeds
PUSH_EVENT_NOTIFICATIONS_ENABLED=false
PUSH_GEOFENCE_NOTIFICATIONS_ENABLED=true
PUSH_LOG_CHANNEL=push

# Fleet alert email + WhatsApp (per-user toggles in Notification Preferences)
ALERT_EMAIL_ENABLED=true
ALERT_WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Vehicle status engine — connectivity tiers (see VehicleStatusSpec)
TRACKING_MOVING_SPEED_KMH=5
TRACKING_DELAYED_MIN_SECONDS=120
TRACKING_STALE_MIN_SECONDS=600
TRACKING_OFFLINE_SECONDS=1800
# @deprecated — use TRACKING_DELAYED_MIN_SECONDS
TRACKING_RECENT_SECONDS=120
TRACKING_GSM_WEAK_PERCENT=25
TRACKING_GPS_WEAK_PERCENT=30
TRACKING_GPS_MIN_SATELLITES=4
# Minutes without GPS before device_offline push (see devices:check-connectivity scheduler)
TRACKING_ONLINE_MINUTES=30

# Public contact page (WhatsApp / email)
CONTACT_WHATSAPP="+966 58 018 8223"
CONTACT_EMAIL=almeghim@billxiot.com

